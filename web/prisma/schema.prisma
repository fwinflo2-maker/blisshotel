generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  OUT_OF_SERVICE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
}

enum StayType {
  SIESTA
  OVERNIGHT
}

enum FolioStatus {
  OPEN
  CLOSED
}

enum FolioLineType {
  ACCOMMODATION
  SERVICE
}

enum RestaurantItemCategory {
  FOOD
  DRINK
  BREAKFAST
  SOFT_DRINK
  JUICE
  WATER
  BEER
  WINE
  WHISKY
  SPIRIT
  COCKTAIL
  STARTER
  DESSERT
  OTHER
}

enum RestaurantStockMovementType {
  SUPPLY
  SALE
  LOSS
  INTERNAL_USE
  ADJUSTMENT
  COUNT
  REVERSAL
}

enum RestaurantTableStatus {
  FREE
  OCCUPIED
  TO_CLEAN
}

enum RestaurantBillingUnit {
  ITEM
  ROOM_NIGHT
}

enum RestaurantOrderSource {
  ROOM_SERVICE
  RESTAURANT
}

enum RestaurantOrderStatus {
  PENDING_RECEPTION
  CONFIRMED
  PREPARING
  READY
  SERVED
  REJECTED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum ReceptionShiftType {
  DAY
  NIGHT
}

enum RestaurantShiftType {
  DAY
  NIGHT
}

enum HousekeepingTaskStatus {
  PENDING
  IN_PROGRESS
  READY_FOR_INSPECTION
  COMPLETED
}

enum HousekeepingStatus {
  CLEAN
  TO_CLEAN
  IN_PROGRESS
  TO_INSPECT
  OUT_OF_SERVICE
}

enum RoomTechnicalStatus {
  OPERATIONAL
  INTERVENTION_REQUIRED
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
}

enum RoomIncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum HousekeepingTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ChatParticipantStatus {
  ACCEPTED
  INVITED
  DECLINED
}

model User {
  id                         String             @id @default(cuid())
  roleId                     String?
  email                      String             @unique @db.VarChar(191)
  name                       String             @db.VarChar(160)
  passwordHash               String
  active                     Boolean            @default(true)
  platformAdmin              Boolean            @default(false)
  lastLoginAt                DateTime?
  createdAt                  DateTime           @default(now())
  role                       Role?              @relation(fields: [roleId], references: [id])
  sessions                   Session[]
  impersonatedSessions       Session[]           @relation("SessionImpersonator")
  resetTokens                ResetToken[]
  notifications              Notification[]
  cashSessions               CashSession[]
  shiftReports               ReceptionShiftReport[]
  createdClients             Client[]           @relation("ClientCreator")
  createdReservations        Reservation[]      @relation("ReservationCreator")
  housekeepingTasksAssigned  HousekeepingTask[] @relation("HousekeepingAssignee")
  housekeepingTaskAssignments HousekeepingTaskAssignment[]
  housekeepingTasksInspected HousekeepingTask[] @relation("HousekeepingInspector")
  managedRooms               Room[]             @relation("HotelRoomAdministrator")
  delegatedPermissions      UserPermission[]
  chatMemberships           ChatParticipant[]
  sentChatMessages           ChatMessage[]

  @@index([roleId])
}

model HotelConfiguration {
  id                       Int      @id @default(1) @db.UnsignedInt
  name                     String   @default("BLISS HOTEL") @db.VarChar(160)
  timezone                 String   @default("UTC") @db.VarChar(64)
  currency                 String   @default("XAF") @db.Char(3)
  checkInTime              String?  @db.VarChar(5)
  checkOutTime             String?  @db.VarChar(5)
  allowCheckoutWithBalance Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}

model CurrencyRate {
  currency    String   @id @db.Char(3)
  xafPerUnit  Decimal  @db.Decimal(16, 6)
  effectiveAt DateTime
  source      String   @db.VarChar(60)
  fetchedAt   DateTime @default(now())
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  code        String
  name        String
  optional    Boolean          @default(false)
  permissions RolePermission[]
  users       User[]

  @@index([code])
}

model Permission {
  code  String           @id @db.VarChar(100)
  group String
  roles RolePermission[]
  users UserPermission[]
}

model RolePermission {
  roleId         String
  permissionCode String     @db.VarChar(100)
  role           Role       @relation(fields: [roleId], references: [id])
  permission     Permission @relation(fields: [permissionCode], references: [code])

  @@id([roleId, permissionCode])
}

model UserPermission {
  userId         String
  permissionCode String     @db.VarChar(100)
  grantedById    String?    @db.VarChar(191)
  grantedAt      DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([userId, permissionCode])
  @@index([permissionCode, userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.Char(64)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  impersonatedById String?
  user      User     @relation(fields: [userId], references: [id])
  impersonatedBy User? @relation("SessionImpersonator", fields: [impersonatedById], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([impersonatedById])
}

model ResetToken {
  tokenHash String   @id @db.Char(64)
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Insertion seule pour le compte SQL d'exécution ; pas d'API de suppression.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  result    String
  targetId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  message   String    @db.VarChar(500)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model ChatConversation {
  id           String             @id @default(cuid())
  title        String?            @db.VarChar(120)
  isGroup      Boolean            @default(false)
  createdById  String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt
  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([updatedAt])
  @@index([createdById])
}

model ChatParticipant {
  id             String                 @id @default(cuid())
  conversationId String
  userId         String
  status         ChatParticipantStatus  @default(ACCEPTED)
  joinedAt       DateTime               @default(now())
  lastReadAt     DateTime?
  conversation   ChatConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, status])
}

model ChatMessage {
  id             String          @id @default(cuid())
  conversationId String
  senderId       String
  body           String          @db.VarChar(4000)
  createdAt      DateTime        @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model RateLimit {
  key       String   @id @db.Char(64)
  attempts  Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model PlatformSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.VarChar(500)
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([updatedAt])
}

model PlatformFeature {
  key       String   @id @db.VarChar(100)
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.VarChar(191)

  @@index([updatedAt])
}

model RoomCategory {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(100)
  capacity    Int?
  nightlyRate Decimal  @db.Decimal(10, 2)
  active      Boolean  @default(true)
  siestaRate  Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  rooms       Room[]

  @@unique([name])
  @@index([active])
}

model Room {
  id                 String             @id @default(cuid())
  categoryId         String
  number             String             @db.VarChar(30)
  floor              String?            @db.VarChar(30)
  capacity           Int?
  bedType            String?            @db.VarChar(100)
  area               Decimal?           @db.Decimal(8, 2)
  description        String?            @db.VarChar(2000)
  observations       String?            @db.VarChar(2000)
  equipment          Json?
  photos             Json?
  active             Boolean            @default(true)
  technicalStatus    RoomTechnicalStatus @default(OPERATIONAL)
  nightlyRateMin     Decimal?           @db.Decimal(10, 2)
  nightlyRateMax     Decimal?           @db.Decimal(10, 2)
  status             RoomStatus         @default(AVAILABLE)
  housekeepingStatus HousekeepingStatus @default(CLEAN)
  category           RoomCategory       @relation(fields: [categoryId], references: [id])
  reservations       Reservation[]
  stays              Stay[]
  housekeepingTasks  HousekeepingTask[]
  statusHistory      RoomStatusHistory[]
  incidents          RoomIncident[]
  restaurantOrders   RestaurantOrder[]
  assignedHotelAdminId String?
  assignedHotelAdmin   User?               @relation("HotelRoomAdministrator", fields: [assignedHotelAdminId], references: [id], onDelete: SetNull)

  @@unique([number])
  @@index([assignedHotelAdminId])
  @@index([status])
  @@index([categoryId])
}

model Client {
  id            String        @id @default(cuid())
  name          String        @db.VarChar(160)
  phone         String?       @db.VarChar(40)
  email         String?       @db.VarChar(191)
  nationality   String?       @db.VarChar(80)
  address       String?       @db.VarChar(255)
  idType        String?       @db.VarChar(40)
  idNumber      String?       @db.VarChar(80)
  notes         String?       @db.VarChar(500)
  idDocumentName       String?   @db.VarChar(160)
  idDocumentMime       String?   @db.VarChar(60)
  idDocumentSize       Int?
  idDocumentData       Bytes?    @db.MediumBlob
  idDocumentUploadedAt DateTime?
  idDocumentUploadedBy String?   @db.VarChar(160)
  createdBy     String?
  createdByName String?       @db.VarChar(160)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  creator       User?         @relation("ClientCreator", fields: [createdBy], references: [id])
  reservations  Reservation[]
  directPayments Payment[]

  @@index([name])
  @@index([phone])
}

model Reservation {
  id                String             @id @default(cuid())
  clientId          String
  roomId            String?
  reference         String             @db.VarChar(40)
  idempotencyKey    String?            @db.VarChar(100)
  status            ReservationStatus  @default(PENDING)
  stayType          StayType           @default(OVERNIGHT)
  plannedCheckInAt  DateTime?
  plannedCheckOutAt DateTime?
  checkInDate       DateTime           @db.Date
  checkOutDate      DateTime           @db.Date
  adults            Int                @default(1)
  children          Int                @default(0)
  nightlyRate       Decimal            @db.Decimal(10, 2)
  inputNightlyRate  Decimal?           @db.Decimal(10, 2)
  inputCurrency     String?            @db.Char(3)
  rateReason        String?            @db.VarChar(500)
  totalAmount       Decimal            @db.Decimal(10, 2)
  createdBy         String
  createdByName     String?            @db.VarChar(160)
  creator           User               @relation("ReservationCreator", fields: [createdBy], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  checkedInAt       DateTime?
  checkedOutAt      DateTime?
  client            Client             @relation(fields: [clientId], references: [id])
  room              Room?              @relation(fields: [roomId], references: [id])
  stay              Stay?
  folio             Folio?
  housekeepingTasks HousekeepingTask[]
  restaurantOrders RestaurantOrder[]

  @@unique([reference])
  @@unique([idempotencyKey])
  @@index([status, checkInDate])
  @@index([roomId, status, checkInDate, checkOutDate])
  @@index([clientId, createdAt])
}

model Stay {
  id                 String      @id @default(cuid())
  reservationId      String      @unique
  roomId             String
  checkedInAt        DateTime    @default(now())
  checkInRecordedAt  DateTime?
  expectedCheckOutAt DateTime?
  checkedOutAt       DateTime?
  checkOutRecordedAt DateTime?
  checkedInBy        String
  checkedOutBy       String?
  reservation        Reservation @relation(fields: [reservationId], references: [id])
  room               Room        @relation(fields: [roomId], references: [id])

  @@index([checkedInAt, checkedOutAt])
  @@index([roomId, checkedOutAt])
}

model Folio {
  id            String      @id @default(cuid())
  reservationId String      @unique
  status        FolioStatus @default(OPEN)
  createdAt     DateTime    @default(now())
  closedAt      DateTime?
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  lines         FolioLine[]
  invoice       Invoice?
  payments      Payment[]

  @@index([status, createdAt])
}

model FolioLine {
  id          String        @id @default(cuid())
  folioId     String
  type        FolioLineType
  description String        @db.VarChar(200)
  amount      Decimal       @db.Decimal(10, 2)
  createdBy   String
  createdAt   DateTime      @default(now())
  restaurantOrderId String? @unique
  folio       Folio         @relation(fields: [folioId], references: [id])
  restaurantOrder RestaurantOrder? @relation(fields: [restaurantOrderId], references: [id])

  @@index([folioId, createdAt])
}

model RestaurantMenuItem {
  id          String                 @id @default(cuid())
  code        String?                @unique @db.VarChar(60)
  name        String                 @db.VarChar(160)
  description String?                @db.VarChar(500)
  category    RestaurantItemCategory
  billingUnit RestaurantBillingUnit @default(ITEM)
  price       Decimal                @db.Decimal(10, 2)
  purchasePrice Decimal?              @db.Decimal(10, 2)
  active      Boolean                @default(true)
  deletedAt   DateTime?              @db.DateTime(3)
  stockQuantity Decimal?             @db.Decimal(10, 2)
  stockUnit    String?               @db.VarChar(30)
  stockAlertAt Decimal?              @db.Decimal(10, 2)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  orderLines  RestaurantOrderLine[]
  stockCounts RestaurantStockCount[]
  stockMovements RestaurantStockMovement[]
  recipeUsages RestaurantRecipeLine[] @relation("RecipeIngredient")
  recipe      RestaurantRecipeLine[] @relation("RecipeDish")

  @@index([active, category, name])
  @@index([deletedAt, active, category])
}

model RestaurantStockCount {
  id          String   @id @default(cuid())
  menuItemId  String
  countedBy   String
  countedByName String @db.VarChar(160)
  previousQuantity Decimal? @db.Decimal(10, 2)
  countedQuantity Decimal @db.Decimal(10, 2)
  note        String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  menuItem    RestaurantMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([menuItemId, createdAt])
}

model RestaurantStockMovement {
  id          String   @id @default(cuid())
  menuItemId  String
  type        RestaurantStockMovementType
  quantity    Decimal  @db.Decimal(10, 2)
  previousQuantity Decimal? @db.Decimal(10, 2)
  resultingQuantity Decimal? @db.Decimal(10, 2)
  reference   String?  @db.VarChar(100)
  note        String?  @db.VarChar(500)
  createdBy   String
  createdByName String @db.VarChar(160)
  createdAt   DateTime @default(now())
  menuItem    RestaurantMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([menuItemId, createdAt])
  @@index([type, createdAt])
}

model RestaurantRecipeLine {
  id             String @id @default(cuid())
  dishId         String
  ingredientId   String
  quantity       Decimal @db.Decimal(10, 3)
  ingredientUnit String @db.VarChar(30)
  dish           RestaurantMenuItem @relation("RecipeDish", fields: [dishId], references: [id], onDelete: Cascade)
  ingredient     RestaurantMenuItem @relation("RecipeIngredient", fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([dishId, ingredientId])
  @@index([ingredientId])
}

model RestaurantTable {
  id        String @id @default(cuid())
  number    String @unique @db.VarChar(30)
  capacity  Int
  status    RestaurantTableStatus @default(FREE)
  active    Boolean @default(true)
  orders    RestaurantOrder[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RestaurantOrder {
  id              String                @id @default(cuid())
  number          String                @unique @db.VarChar(40)
  source          RestaurantOrderSource
  status          RestaurantOrderStatus @default(PENDING_RECEPTION)
  receptionReadAt DateTime?
  reservationId   String?
  roomId          String?
  guestName       String                 @db.VarChar(160)
  notes           String?                @db.VarChar(500)
  totalAmount     Decimal                @db.Decimal(10, 2)
  createdBy       String
  createdByName   String                 @db.VarChar(160)
  confirmedBy     String?                @db.VarChar(191)
  confirmedByName String?                @db.VarChar(160)
  confirmedAt     DateTime?
  rejectedBy      String?                @db.VarChar(191)
  rejectedByName  String?                @db.VarChar(160)
  rejectedAt      DateTime?
  preparedAt      DateTime?
  readyAt         DateTime?
  servedAt        DateTime?
  paidAt          DateTime?
  paidBy          String?               @db.VarChar(191)
  paidByName      String?               @db.VarChar(160)
  paymentMethodId String?
  tableId         String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  reservation     Reservation?           @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  room            Room?                  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  lines           RestaurantOrderLine[]
  folioLine       FolioLine?
  paymentMethod   PaymentMethod?         @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  table           RestaurantTable?       @relation(fields: [tableId], references: [id], onDelete: SetNull)
  payments        RestaurantPayment[]
  cashPayment     Payment?

  @@index([status, createdAt])
  @@index([reservationId, createdAt])
  @@index([roomId, createdAt])
  @@index([confirmedAt])
  @@index([paidAt])
}

model RestaurantOrderLine {
  id          String                 @id @default(cuid())
  orderId     String
  menuItemId  String?
  name        String                 @db.VarChar(160)
  category    RestaurantItemCategory
  billingUnit RestaurantBillingUnit
  quantity    Int
  unitPrice   Decimal                @db.Decimal(10, 2)
  lineTotal   Decimal                @db.Decimal(10, 2)
  order       RestaurantOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem    RestaurantMenuItem?    @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([menuItemId])
}

model Invoice {
  id          String   @id @default(cuid())
  folioId     String   @unique
  number      String   @db.VarChar(60)
  payerName   String?  @db.VarChar(160)
  currency    String   @default("XAF") @db.Char(3)
  totalAmount Decimal  @db.Decimal(10, 2)
  issuedAt    DateTime @default(now())
  folio       Folio    @relation(fields: [folioId], references: [id])

  @@unique([number])
  @@index([issuedAt])
}

model PaymentMethod {
  id       String    @id @default(cuid())
  code     String    @db.VarChar(40)
  name     String    @db.VarChar(80)
  active   Boolean   @default(true)
  payments Payment[]
  shiftExpenses ReceptionShiftExpense[]
  restaurantOrders RestaurantOrder[]
  restaurantPayments RestaurantPayment[]

  @@unique([code])
  @@index([active])
}

model RestaurantPayment {
  id              String @id @default(cuid())
  orderId         String
  paymentMethodId String
  amount          Decimal @db.Decimal(10, 2)
  idempotencyKey  String @unique @db.VarChar(100)
  reference       String? @db.VarChar(100)
  receivedBy      String
  receivedByName  String @db.VarChar(160)
  confirmedAt     DateTime @default(now())
  order           RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@index([orderId, confirmedAt])
  @@index([paymentMethodId, confirmedAt])
}

model CashSession {
  id            String            @id @default(cuid())
  userId        String
  activeKey     String?           @unique @db.VarChar(400)
  status        CashSessionStatus @default(OPEN)
  openingAmount Decimal           @db.Decimal(10, 2)
  countedAmount Decimal?          @db.Decimal(10, 2)
  expectedCash  Decimal?          @db.Decimal(10, 2)
  variance      Decimal?          @db.Decimal(10, 2)
  openedAt      DateTime          @default(now())
  closedAt      DateTime?
  shiftType     RestaurantShiftType?
  shiftStartedAt DateTime?
  shiftEndedAt   DateTime?
  user          User              @relation(fields: [userId], references: [id])
  payments      Payment[]
  shiftReport   ReceptionShiftReport?

  @@index([userId, status])
  @@index([userId, openedAt])
}

model ReceptionShiftReport {
  id            String                    @id @default(cuid())
  cashSessionId String                    @unique
  userId        String
  shiftType     ReceptionShiftType
  shiftDate     DateTime                  @db.Date
  startedAt     DateTime
  endedAt       DateTime
  summary       Json
  incidentNotes String?                   @db.VarChar(2000)
  handoverNotes String?                   @db.VarChar(2000)
  createdAt     DateTime                  @default(now())
  cashSession   CashSession               @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  user          User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  expenses      ReceptionShiftExpense[]

  @@index([shiftDate, shiftType])
  @@index([userId, startedAt])
  @@index([startedAt])
}

model ReceptionShiftExpense {
  id              String               @id @default(cuid())
  reportId        String
  description     String               @db.VarChar(200)
  amount          Decimal              @db.Decimal(10, 2)
  paymentMethodId String
  createdAt       DateTime             @default(now())
  report          ReceptionShiftReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  paymentMethod   PaymentMethod        @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@index([paymentMethodId, createdAt])
}

model Payment {
  id              String        @id @default(cuid())
  folioId         String?
  clientId        String?
  restaurantOrderId String? @unique
  cashSessionId   String
  paymentMethodId String
  receivedBy      String
  idempotencyKey  String        @unique @db.VarChar(100)
  amount          Decimal       @db.Decimal(10, 2)
  inputAmount     Decimal?      @db.Decimal(10, 2)
  inputCurrency   String?       @db.Char(3)
  description     String?       @db.VarChar(200)
  reference       String?       @db.VarChar(100)
  createdAt       DateTime      @default(now())
  folio           Folio?        @relation(fields: [folioId], references: [id])
  client          Client?       @relation(fields: [clientId], references: [id])
  cashSession     CashSession   @relation(fields: [cashSessionId], references: [id])
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  restaurantOrder RestaurantOrder? @relation(fields: [restaurantOrderId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([folioId, createdAt])
  @@index([clientId, createdAt])
  @@index([cashSessionId, createdAt])
}

model HousekeepingTask {
  id                   String                 @id @default(cuid())
  roomId               String
  reservationId        String?
  title                String                 @default("Entretien chambre") @db.VarChar(160)
  taskType             String                 @default("STANDARD") @db.VarChar(40)
  priority             HousekeepingTaskPriority @default(NORMAL)
  checklist            Json?
  observation          String?                @db.VarChar(1000)
  dueAt                DateTime?
  notes                String?                @db.VarChar(500)
  status               HousekeepingTaskStatus @default(PENDING)
  createdBy            String
  assignedTo           String?
  activeRoomId         String?                @unique
  startedAt            DateTime?
  readyForInspectionAt DateTime?
  inspectedBy          String?
  inspectedAt          DateTime?
  inspectionNote       String?                @db.VarChar(500)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now()) @updatedAt
  room                 Room                   @relation(fields: [roomId], references: [id])
  reservation          Reservation?           @relation(fields: [reservationId], references: [id])
  assignee             User?                  @relation("HousekeepingAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  assignments          HousekeepingTaskAssignment[]
  inspector            User?                  @relation("HousekeepingInspector", fields: [inspectedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([roomId, status])
  @@index([assignedTo, status, createdAt])
}

model HousekeepingTaskAssignment {
  id        String           @id @default(cuid())
  taskId    String
  agentId   String
  createdAt DateTime         @default(now())
  task      HousekeepingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent     User             @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([taskId, agentId])
  @@index([agentId, createdAt])
}

model RoomStatusHistory {
  id           String   @id @default(cuid())
  roomId       String
  dimension    String   @db.VarChar(30)
  previousStatus String? @db.VarChar(50)
  nextStatus   String   @db.VarChar(50)
  reason       String?  @db.VarChar(500)
  source       String   @db.VarChar(50)
  actorId      String?
  createdAt    DateTime @default(now())
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([roomId, createdAt])
  @@index([dimension, createdAt])
}

model RoomIncident {
  id          String             @id @default(cuid())
  roomId      String
  title       String             @db.VarChar(160)
  description String?            @db.VarChar(1000)
  status      RoomIncidentStatus @default(OPEN)
  reportedBy  String
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  room        Room               @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([roomId, status, createdAt])
  @@index([status, createdAt])
}
